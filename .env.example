# MySQL 8.0.19+ reachable from the Vercel Node.js runtime. Never prefix secrets with VITE_.
MYSQL_URL=mysql://username:password@host:3306/dentista_do_povo
MYSQL_SSL=true
# Optional private CA in PEM format (escaped newlines are accepted).
# MYSQL_SSL_CA=

# Local setup commands only; remove these after creating the administrator.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Read-only migration source. Not required in Vercel or during normal operation.
# POSTGRES_SOURCE_URL=postgresql://...

# Optional AI service; the app and human chat work without it.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_MODEL=

# Optional Google AdSense (blog ad slots). Public/client-side, must keep the
# VITE_ prefix. Ads render nowhere until this is set. Get the client ID from
# your AdSense account (Account -> Account information), and each slot ID
# from an ad unit you create in AdSense -> Ads -> By ad unit.
# VITE_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
