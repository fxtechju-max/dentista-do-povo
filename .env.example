# Supabase Postgres connection string (server-only; never prefix with VITE_).
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543) URI, with the
# database password filled in. Also set it in Vercel -> Settings -> Environment Variables.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Local setup commands only; remove these after creating the administrator.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Read-only source for `bun run db:import` (copies data from the old MySQL).
# Not required in Vercel or during normal operation.
# MYSQL_SOURCE_URL=mysql://username:password@host:3306/dentista_do_povo
# MYSQL_SOURCE_SSL=true

# Optional AI service; the app and human chat work without it.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_MODEL=

# Google AdSense: configurado na área restrita (Configurações › Anúncios),
# não precisa de variável de ambiente. O /ads.txt é gerado automaticamente.
